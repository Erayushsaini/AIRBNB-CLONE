<%layout("layouts/boilerplate.ejs")%>

<h2>Edit Listing</h2>
<div class="box"> 
    <form action="/listings/<%=listing.id%>/?_method=PUT" method="post" class="form-container">
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input name="listing[title]" class="form-control" type="text" id="title"  value="<%=listing.title%>">

            <label for="image" class="form-label">image link</label>
            <input name="listing[image]"   class="form-control" type="text" id="image"   value="<%=listing.image%>">

            <label for="description" class="form-label">Discription</label>
            <textarea name="listing[description]" id="description" class="form-control"><%=listing.description%></textarea>
            <label for="price" class="form-label">Price</label>
            <input name="listing[price]"   class="form-control" type="text" id="title"   value="<%=listing.price%>">

            <label for="location" class="form-label">Location</label>
            <input name="listing[location]" type="text" class="form-control" id="location"  value="<%=listing.location%>">

            <label for="country" class="form-label">country</label>
            <input name="listing[country]" class="form-control" id="country" type="text" value="<%=listing.country%>">
            <button class="btn btn-primary"> edit</button>
        </div>  
    </form>
</div>

