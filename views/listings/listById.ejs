<%layout("layouts/boilerplate.ejs")%>
<div class="box">
<div class="card-id">
  <div class="card-id-top">
    <img src="<%=data.image%>" class="card-img-top" alt="image">
    <div>
    <form action="/listings/<%=data.id%>/edit" method="get">
        <button type="submit" class="btn btn-primary">EDIT</button>
    </form>
    <form action="/listings/<%=data.id%>/?_method=DELETE" method="post">
        <button type="submit" class="btn btn-primary">DELETE</button>
    </form>
    </div>
    </div>  
  <div class="card-body">
    <h5 class="card-title"><%=data.title%></h5>
    <p class="card-text"><%=data.description%></p>
    <p class="card-text">&#8377; <%=Number(data.price).toLocaleString("en-IN")%></p>
    <p class="card-text"><%=data.location%></p>
    <p class="card-text"><%=data.country%></p>
  </div>
  
</div>
</div>

